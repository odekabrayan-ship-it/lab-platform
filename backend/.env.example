# ==============================================================================
# QUALICORE LABORATORY PLATFORM — ENVIRONMENT CONFIGURATION
# ISO 17025 Sovereign Trust Network
# ==============================================================================
# CRITICAL: Never commit this file to version control.
# Copy this to .env and populate with real values before deployment.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Security: JWT ---
# MUST be replaced with a cryptographically secure random string (min 64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET_BEFORE_DEPLOYMENT
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# --- SMTP Email (Nodemailer) ---
# Supports: Gmail (with App Password), SendGrid, Mailgun, Postfix, any SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-lab-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM_NAME=QualiCore Laboratory Network
SMTP_FROM_EMAIL=noreply@qualicore.lab

# --- Lab Branding (used in email templates) ---
LAB_PLATFORM_NAME=QualiCore
LAB_PLATFORM_URL=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# --- Database ---
DB_PATH=./database.sqlite
PUBLIC_DB_PATH=./public_database.sqlite

# --- File Storage ---
STORAGE_DIR=./storage/reports

# --- Subscription Sentinel ---
SENTINEL_INTERVAL_HOURS=24
TAT_SENTINEL_INTERVAL_HOURS=4
